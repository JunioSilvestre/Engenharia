# ==========================================
# Cross-Platform & Developer Git Ignore
# ==========================================

# --- Operating System Files ---
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# --- IDEs & Editors ---
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (IntelliJ, PyCharm, WebStorm, etc.)
.idea/
*.iml
*.iws
*.ipr

# Vim & Emacs
*.swp
*.swo
*.swn
.*.sw[a-p]
*~
\#*\#
.\#*

# Sublime Text
*.sublime-workspace
*.sublime-project

# --- Secrets, Credentials & Sensitive Files ---
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
*.crt
*.pfx
*.p12
*.kdbx
id_rsa
id_dsa
id_ed25519
known_hosts

# --- Logs & Databases ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.sqlite
*.sqlite3
*.db

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Terraform / IaC ---
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
!*.tfvars.example

# --- Ansible ---
*.retry

# --- Node / Frontend (se aplicável) ---
node_modules/
.npm/

# --- Temporary & Cache Files ---
*.tmp
*.temp
.cache/
